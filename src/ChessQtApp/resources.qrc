    <qresource prefix="/pieces">
        <file alias="white_pawn.png">../../images/white_pawn.png</file>
        <file alias="white_rook.png">../../images/white_rook.png</file>
        <file alias="white_knight.png">../../images/white_knight.png</file>
        <file alias="white_bishop.png">../../images/white_bishop.png</file>
        <file alias="white_queen.png">../../images/white_queen.png</file>
        <file alias="white_king.png">../../images/white_king.png</file>
        <file alias="black_pawn.png">../../images/black_pawn.png</file>
        <file alias="black_rook.png">../../images/black_rook.png</file>
        <file alias="black_knight.png">../../images/black_knight.png</file>
        <file alias="black_bishop.png">../../images/black_bishop.png</file>
        <file alias="black_queen.png">../../images/black_queen.png</file>
        <file alias="black_king.png">../../images/black_king.png</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="new-game.svg">icons/new-game.svg</file>
        <file alias="undo.svg">icons/undo.svg</file>
        <file alias="redo.svg">icons/redo.svg</file>
        <file alias="resign.svg">icons/resign.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="flip.svg">icons/flip.svg</file>
        <file alias="analysis.svg">icons/analysis.svg</file>
        <file alias="human-vs-human.svg">icons/human-vs-human.svg</file>
        <file alias="human-vs-engine.svg">icons/human-vs-engine.svg</file>
        <file alias="difficulty.svg">icons/difficulty.svg</file>
        <file alias="sound.svg">icons/sound.svg</file>
        <file alias="theme.svg">icons/theme.svg</file>
        <file alias="draw.svg">icons/draw.svg</file>
    </qresource>
</RCC>
